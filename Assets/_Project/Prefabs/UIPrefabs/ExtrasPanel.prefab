      m_Calls: []
  m_text: 'Forget Robots specialize in area attacks that apply Burn. Their special
    abilities can apply random control effects such as Confusion, Dizzy, and Hypnosis,
    or force the robot to draw enemy attention through Taunt.


    Their passive
    allows them to recover through Regeneration when attacked while an enemy is affected
    by Burn.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
  m_sharedMaterial: {fileID: -4590058019579560374, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
