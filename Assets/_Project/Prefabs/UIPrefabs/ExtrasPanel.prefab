  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Beef specializes in powerful attacks and benefits greatly from buffs,
    while Meat focuses on enhancing itself and its allies and exploiting enemies
    affected by debuffs.


    Their ultimate ability, Animal Outburst, consumes
    all four actions to deal extreme guaranteed area damage and resummon all of their
    allies. Their passive abilities further increase the benefits of buffs and damage
    against debuffed enemies.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
