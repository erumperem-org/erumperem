  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Torch Mechanics


    Added a 5-second cooldown when switching the torch
    on or off.


    Added an on-screen notification when the torch cannot be switched
    due to cooldown.


    Prevented the torch from being lit near the village.


    The
    torch now turns off automatically when entering the protected area.


    Enemy
    Threat & Pursuit


    Added a new threat warning: "They see you".


    Introduced
    distant screams, subtle red visual pulses, camera shake, and music transitions
    to reinforce the threat of being spotted.


    Camera shake now increases gradually
    as enemies approach and decreases as they move away.


    Adjusted enemy detection
    screams to prevent repeated playback during the same activation.


    Exploration
    Audio


    Added directional ambient sounds at randomized positions and intervals
    around the player, outside the village and combat.


    Added distance-based
    directional audio for torches and campfires.


    Added proximity-based ambient
    audio that responds to the corruption boundary.


    Added sound effects for
    opening chests and interacting with objects.


    Added a dedicated musical
    track for the village.


    Improved music transitions when returning to exploration
    to prevent threat music from playing incorrectly while the torch is off.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
