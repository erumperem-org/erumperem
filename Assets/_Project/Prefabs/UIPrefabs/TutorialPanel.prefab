  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ghosts spawn every 3 seconds through a pooling system. Only the spawner
    the player is currently within, along with nearby spawners, is active and capable
    of spawning enemies. Ghosts always spawn outside the player's screen range.\r\n\r\nThe
    ghost model is determined by the current Corruption Tier.\r\n\r\nGhosts wander
    randomly through the environment and will chase the player when they spot them.
    They stop chasing once they lose sight of the player, which can happen if the
    player turns off the torch in time.\r\n\r\nA secondary spawn system creates a
    ghost every 9 seconds. These ghosts actively pursue the player until they spot
    them, providing a consistent source of potential encounters throughout exploration.\r\n\r\nIf
    the player comes into contact with a ghost, they are taken to a combat scene
    where their current Main and Companion characters fight against four monsters.\r\n\r\nA
    Boss can also be found at the edges of the map, triggering a mandatory boss encounter
    when reached.\r\n\r\nThe exploration system encourages the player to make strategic
    use of the torch mechanic. Keeping the torch lit allows pursuing ghosts to detect
    and begin chasing the player from a greater distance, while turning it off reduces
    their field of vision and allows the player to escape if timed correctly.\r\n\r\nThe
    combination of wandering ghosts and secondary spawns ensures that the player
    has the opportunity to experience approximately 4\u20135 combat encounters before
    reaching the Boss at the edge of the map."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
  m_sharedMaterial: {fileID: -4590058019579560374, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
