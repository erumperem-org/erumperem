  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Combat uses Tokens to represent temporary buffs and debuffs affecting
    characters during battle.\r\n\r\nDuring the tutorial, the Training Dummy applies
    a debuff to the player while gaining a buff itself, allowing the player to learn
    how these effects work.\r\n\r\nPlayers can hover over a Token with the mouse
    to view information about its effect.\r\n\r\n\u201CYou\u2019re bleeding, which
    means you\u2019ll lose blood over time. Pretty obvious. But your enemy seems
    stronger too, doesn\u2019t it? Try paying closer attention.\u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
  m_sharedMaterial: {fileID: -4590058019579560374, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
