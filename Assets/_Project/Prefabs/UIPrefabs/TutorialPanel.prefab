  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Corruption system reflects the consequences of surviving in a corrupted
    world.\r\n\r\nEvery effort the player makes to survive causes their Corruption
    to increase. Higher Corruption strengthens the player's capabilities, but also
    makes the world around them increasingly dangerous.\r\n\r\n\u201CEvery effort
    to survive in this corrupted world makes the corruption grow. It strengthens
    you, but it also makes the world around you more dangerous.\u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
  m_sharedMaterial: {fileID: -4590058019579560374, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
