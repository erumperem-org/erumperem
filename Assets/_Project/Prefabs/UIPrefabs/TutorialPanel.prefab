  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "4 inimigos do tipo \u201Cboneco de treino\u201D aparecem; o NPC explica
    as mec\xE2nicas de combate:\n\nExplica que inimigos costumam atacar primeiro
    a menos que voc\xEA tenha muita sorte. > \u201Cvoc\xEA precisa acostumar com
    estar em desvantagem, l\xE1 fora voc\xEA sempre ser\xE1 atacado em grupos, muitas
    das vezes antes de voc\xEA poder agir\u201D\n\nExplica que voc\xEA deve derrotar
    todos inimigos para poder seguir a jornada. > \u201CA menos que queira morrer,
    agora \xE9 hora de revidar, voc\xEA s\xF3 conseguir\xE1 fugir se derrotar todos
    eles\u201D\n\nExplica que o sistema de corrup\xE7\xE3o > \u201Cqualquer esfor\xE7o
    para sobreviver nesse mundo corrompido faz com que a corrup\xE7\xE3o aumente,
    fortalecendo suas capacidades mas tamb\xE9m tornando o mundo ao redor mais perigoso\u201D\n\nExplica
    sobre tokens (o boneco de treino vai criar um debuff no player e buff em si mesmo),
    indicando que fazer hover com o mouse fala sobre o efeito. > \u201Cvoc\xEA est\xE1
    sangrando, significa que vai perder sangue com o tempo. Um tanto \xF3bvio. Mas
    seu inimigo parece mais forte, tamb\xE9m, n\xE3o? Tente observar com mais aten\xE7\xE3o\u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
  m_sharedMaterial: {fileID: -4590058019579560374, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
