  m_text: 'Strength: Increases damage.

    Defense: Reduces damage taken.

    Weaken:
    Reduces damage dealt.

    Vulnerability: Increases damage taken.

    Regeneration:
    Restores HP over time.

    Lucky Shot: Increases Critical Chance.

    Dexterity:
    Increases Accuracy.

    Clumsy: Reduces Accuracy.

    Confusion: Randomizes
    skill targets.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
  m_sharedMaterial: {fileID: -4590058019579560374, guid: 5f8e6024aadc5a046ade11ad5290a252, type: 2}
