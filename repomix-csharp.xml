        public Transform TryGetUnitVisualRoot(string combatantId)
        {
            if (string.IsNullOrEmpty(combatantId) ||
                !_runtime.UnitVisualRootsByCombatantId.TryGetValue(combatantId, out var root))
            {
                return null;
            }

            return root;
