    public static class CombatSkillPlayerDescriptionFormatter
    {
        public static string BuildSummaryLine(
            SkillDefinition skill,
            BattleState battleState = null,
            Combatant actor = null,
            Combatant previewTarget = null)
        {
            if (skill == null)
            {
                return string.Empty;
