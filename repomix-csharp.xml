    }

    public void ClosePanel(GameObject panel)
    {
        if (panel == null)
        {
            Debug.LogWarning("UIManager: ClosePanel called with a null panel reference.");
            return;
        }

        if (!panel.activeSelf)
        {
            return;
        }
        panel.SetActive(false);
    }
}
