            .Where(combatEvent => combatEvent.EventType == BattleEventType.DamageApplied && combatEvent.SkillId == smack.Id)
            .Select(combatEvent => combatEvent.DamageAmount)
            .ToList();
        Assert.NotEmpty(damageAmounts);
