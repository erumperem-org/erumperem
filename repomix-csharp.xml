            Debug.LogWarning($"Skill slot {zeroBasedSlot + 1} indisponível (alvo ou fora do loadout).");
            PublishPlayerSkillHelpForAlly(_runtime.PendingPlayerActor, FindAllyIndex(_runtime.PendingPlayerActor));
        }

