    /// <summary>Defendeu e recebeu dano (hit directo ou DOT tick). Inclui <see cref="CombatPassiveEventContext.HpPercentBefore"/> / <see cref="CombatPassiveEventContext.HpPercentAfter"/> quando aplicável.</summary>
